[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Players"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Player Hitbox"
2d_physics/layer_5="Enemy Hitbox"
2d_physics/layer_6="Projectiles"
2d_physics/layer_7="Interactables"
2d_physics/layer_8="Triggers"
2d_physics/layer_9="NPC"
2d_physics/layer_10="Special"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
